<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="..\..\..\SharedFrameworkAssemblyInfo.props" />
	<Import Project="..\..\..\SharedFrameworkMARIAssemblyInfo.props" />

	<PropertyGroup>

		<IsPackable>true</IsPackable>
		<Description>MARI extension cluster library using docker.</Description>

		<PackageTags>MARI;Orleans;Multi-VGrain;Multi-Grain;Multi-Agents;Framework;Cluster;Mongo;Extension</PackageTags>

	</PropertyGroup>

	<ItemGroup>
	  <None Remove="Resources\GrainDockerfile.template" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Include="Resources\GrainDockerfile.template">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Docker.DotNet" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\Frameworks\MARI.Framework.Node.Abstractions\MARI.Framework.Node.Abstractions.csproj" />
	  <ProjectReference Include="..\..\Frameworks\MARI.Framework.Node\MARI.Framework.Node.csproj" />
	  <ProjectReference Include="..\MARI.Framework.Extensions.Docker.Abstractions\MARI.Framework.Extensions.Docker.Abstractions.csproj" />
	</ItemGroup>

</Project>
